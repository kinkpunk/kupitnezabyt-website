---
const situations = [
  'Кофе, шампунь или таблетки заканчиваются неожиданно.',
  'Повторяющиеся покупки живут в памяти, заметках и нескольких чатах.',
  'Список покупок устаревает сразу после похода в магазин.',
];
---

<section class="section problem" aria-labelledby="problem-title">
  <div class="container">
    <h2 id="problem-title">Обычный список появляется слишком поздно.</h2>
    <ul class="problem__list">
      {situations.map((situation) => <li>{situation}</li>)}
    </ul>
  </div>
</section>
