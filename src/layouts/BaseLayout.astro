---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../content/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Выводить WebSite JSON-LD (только главная страница). */
  webSiteJsonLd?: boolean;
}

const { title = site.defaultTitle, description = site.defaultDescription, webSiteJsonLd = false } =
  Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL as string | undefined;
const canonical = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : undefined;
// og:image должен быть абсолютным; если PUBLIC_SITE_URL не задан,
// выводим корневой относительный путь, чтобы тег существовал (см. README).
const ogImage = siteUrl
  ? new URL('/images/og-cover.png', siteUrl).toString()
  : '/images/og-cover.png';
const ogImageAlt = 'kupitnezabyt — Помнить о нужном — проще';

const jsonLd = webSiteJsonLd && canonical
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: canonical,
      inLanguage: 'ru',
      description: site.defaultDescription,
    })
  : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
