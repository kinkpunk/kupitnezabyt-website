# Set this to the final canonical URL in Vercel after the first deployment.
PUBLIC_SITE_URL=

# Confirmed PWA URL. All calls to action will use this value through one helper.
PUBLIC_APP_URL=https://kupitnezabyt-webapp.vercel.app/

# Analytics remains disabled until a provider and privacy approach are approved.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_SITE_ID=
